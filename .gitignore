# Each project has its own .gitignore; these rules cover the repository root
# and act as a safety net for both projects.

# dependencies and build output
node_modules/
dist/
coverage/

# environment: never commit real secrets
.env
.env.*
!.env.example
!.env.test.example

# logs
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
