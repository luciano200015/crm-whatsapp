# Copy to .env.local to override. Everything here is optional.

# API base URL. In development the Vite proxy forwards /api to the backend.
# VITE_API_BASE_URL=/api/v1
# Backend target for the dev proxy (vite.config.ts).
# VITE_API_PROXY_TARGET=http://localhost:3000

# Branding overrides (see src/theme/theme.config.ts for everything else).
# VITE_BRAND_NAME=Mi CRM
# VITE_BRAND_TAGLINE=Tu CRM, en un solo lugar
# VITE_BRAND_LOGO_URL=/logo.svg
# VITE_PRIMARY_COLOR=#22c55e
# VITE_DEFAULT_COLOR_MODE=dark

# Development inbox link shown after sign-up.
# VITE_MAILPIT_URL=http://localhost:8025
