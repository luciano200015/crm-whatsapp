# Copy to .env.test. Used by `npm run test:int` and `npm run test:e2e`.
# Points at the crm_test database created by docker/postgres/init.
NODE_ENV=test
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=silent
SWAGGER_ENABLED=false
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

DATABASE_URL=postgresql://crm:change-me@localhost:5433/crm_test?schema=public
MONGODB_URI=mongodb://crm:change-me@localhost:27018/crm_test?authSource=admin

# Generate with: npm run secrets:generate (use different values than .env)
JWT_PRIVATE_KEY=change-me
JWT_PUBLIC_KEY=change-me
TOKEN_HASH_SECRET=change-me
# Tests replace the mailer with an in-memory outbox; SMTP is never contacted.
AUTH_THROTTLE_LIMIT=1000

# Billing: simulated payments so the whole subscription lifecycle can be tested.
BILLING_PAYMENTS_MODE=simulated

# Channels: tests never call Meta.
CHANNEL_SECRETS_KEY=change-me
WHATSAPP_MODE=simulated
