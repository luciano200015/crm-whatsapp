# Copy to .env and replace every "change-me". Never commit .env.

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (no "*" in production).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Defaults to true outside production, false in production.
SWAGGER_ENABLED=true

# ── Refresh-token cookie ───────────────────────────────────────
# Leave COOKIE_DOMAIN unset for host-only cookies (recommended).
# COOKIE_DOMAIN=example.com
# Must be true in production. false only for plain-http local dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ── Docker Compose (local infrastructure) ──────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
POSTGRES_PORT=5433
MONGO_ROOT_USER=crm
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27018
REDIS_PASSWORD=change-me
REDIS_PORT=6380

# ── Connection strings (must match the values above) ───────────
DATABASE_URL=postgresql://crm:change-me@localhost:5433/crm?schema=public
MONGODB_URI=mongodb://crm:change-me@localhost:27018/crm?authSource=admin
# Optional until Redis is wired in.
# REDIS_URL=redis://:change-me@localhost:6380

# Express trust proxy: false (direct), true, or number of proxy hops in front of the API.
TRUST_PROXY=false

# ── Token secrets ──────────────────────────────────────────────
# Generate with: npm run secrets:generate  (paste the three lines here)
# ES256 key pair, base64-encoded PEM.
JWT_PRIVATE_KEY=change-me
JWT_PUBLIC_KEY=change-me
# HMAC secret for hashing refresh/reset/verification/invitation tokens (>= 32 chars).
TOKEN_HASH_SECRET=change-me
JWT_ISSUER=backend-crm
JWT_AUDIENCE=backend-crm-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# ── Rate limiting for auth endpoints (requests per IP per window) ──
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# ── Mail (Mailpit in docker-compose; inbox UI at http://localhost:8025) ──
# Base URL used in email links (frontend). Defaults to APP_URL.
WEB_APP_URL=http://localhost:5173
MAIL_FROM=CRM <no-reply@crm.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Demo data (development only; never in production) ──
# Creates superadmin@example.com and other demo users/workspaces on `npm run db:seed`.
SEED_DEMO_DATA=false
# Shared password for the demo users (>= 12 chars). Pick your own.
SEED_DEMO_PASSWORD=change-me

# ── Billing (plans & subscriptions) ──
# Free trial for new sign-ups, in days (0 = no trial: the plan must be paid first).
BILLING_TRIAL_DAYS=7
# Plan given at sign-up when none is chosen (codes: team, business, corporate).
BILLING_DEFAULT_PLAN=team
BILLING_DEFAULT_INTERVAL=MONTH
BILLING_CURRENCY=USD
# disabled = no payments yet; simulated = payments succeed instantly (dev only, refused in production).
BILLING_PAYMENTS_MODE=disabled
