{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // nest build wipes dist/ (deleteOutDir); a stale .tsbuildinfo would make tsc emit nothing.
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*.spec.ts", "**/*.fakes.ts"]
}
